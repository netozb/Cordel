# Lista de tarefas que fica guardada neste aparelho
var tarefas = guardado("tarefas", [])
var nova = ""

tela "Minhas tarefas"
  cor "caatinga"
  # a tela é redesenhada a cada toque; guardar aqui salva sempre
  guarde("tarefas", tarefas)

  linha
    campo "Nova tarefa" em nova
    botão "Adicionar"
      se nova.aparado != ""
        tarefas.adicione({texto: nova.aparado, feita: falso})
        nova = ""
      fim
    fim
  fim

  para i de 1 até tarefas.tamanho
    marque tarefas[i].texto em tarefas[i].feita
  fim

  feitas = tarefas.conte(t => t.feita)
  mostre "{feitas} de {tarefas.tamanho} feitas"
  se feitas > 0
    botão "Limpar as feitas"
      tarefas = tarefas.filtre(t => não t.feita)
    fim
  fim
fim
