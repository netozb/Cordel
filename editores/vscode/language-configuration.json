{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "“",
      "close": "”",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "“",
      "”"
    ]
  ],
  "wordPattern": "(-?\\d[\\d_]*(?:\\.\\d+)?)|([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((se|enquanto|para|repita|escolha|caso|tente|teste|tela)\\b(?!.*\\bfim\\s*(#.*)?$)|sen[aã]o\\b|falhou\\b|fun[cç][aã]o\\s[^=]*$|(bot[aã]o|p[aá]gina)\\s+(?![-+*/]?=)[^.(=]|(cart[aã]o|linha)\\s*(#.*)?$)",
    "decreaseIndentPattern": "^\\s*(fim|sen[aã]o|falhou|caso)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*regi[aã]o\\b",
      "end": "^\\s*#\\s*fim da regi[aã]o\\b"
    }
  }
}
