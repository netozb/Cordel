ipca = índice("IPCA")
mostre ipca.nome, "·", ipca.descrição
a = ipca.acumulado(data("01/01/2025"), data("31/12/2025"))
mostre a.arredondado(4), a.origem
mostre ipca.fator(data("15/01/2025"), data("10/03/2025"))
mostre 1000.corrigido("ipca", data("01/01/2025"), data("31/03/2025")).dinheiro
mostre 1000.corrigido(ipca, data("01/01/2025"), data("31/03/2025")) == 1000 * ipca.fator(data("01/01/2025"), data("31/03/2025"))
mostre ipca.série(data("01/02/2025"), data("31/03/2025"))
selic = índice("selic")
mostre selic.acumulado(data("01/09/2025"), data("05/09/2025")).arredondado(6)
mostre selic.acumulado(data("06/09/2025"), data("08/09/2025"))
mostre selic.fator(data("01/09/2025"), data("01/09/2025"))
mostre cotação("dólar", data("28/08/2026")), cotação("USD", data("30/08/2026")).origem
mostre índice("IGP-M").nome, índice("igpm").nome, índice("inpc").nome, índice("CDI").nome
tente
  mostre ipca.acumulado(data("01/09/2026"), data("30/09/2026"))
falhou erro
  mostre erro
fim
