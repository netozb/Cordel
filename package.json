    "cordel",
    "linguagem",
    "programação",
    "português",
    "ensino",
    "planilhas",
    "interpretador"
  ],
  "license": "MIT",
  "author": "Antônio Duarte Neto",
  "bin": {
    "cordel": "bin/cordel.js"
  },
  "main": "lib/cordel.js",
  "types": "lib/cordel.d.ts",
  "files": [
